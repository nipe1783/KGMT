close all; clc; clear;

% Load data from two runs
load('KPAX_0.1mill_10_3_3_3_6DDI_house.mat', 'bestCostMatrix', 'timeGrid');
bestCostMatrix1 = bestCostMatrix / 1;  % Scale down by 1
timeGrid1 = timeGrid;

load('OKPAX_0.1mill_10_3_3_3_6DDI_house.mat', 'bestCostMatrix', 'timeGrid');
bestCostMatrix2 = bestCostMatrix / 1;  % Scale down by 1
timeGrid2 = timeGrid;

% Overlay the box plots
figure;
hold on;
boxplot1 = boxplot(bestCostMatrix1', 'positions', timeGrid1, 'colors', [0, 0, 1], 'symbol', '.', 'OutlierSize', 4);
boxplot2 = boxplot(bestCostMatrix2', 'positions', timeGrid2, 'colors', [1, 0, 0], 'symbol', '.', 'OutlierSize', 4);

% Fill boxes with specific colors
h1 = findobj(gca, 'tag', 'Box', 'Color', [0, 0, 1]);
h2 = findobj(gca, 'tag', 'Box', 'Color', [1, 0, 0]);

for j = 1:length(h1)
    patch(get(h1(j), 'XData'), get(h1(j), 'YData'), 'b', 'FaceAlpha', .5); % Blue for KPAX
end
for j = 1:length(h2)
    patch(get(h2(j), 'XData'), get(h2(j), 'YData'), 'r', 'FaceAlpha', .5); % Red for OKPAX
end

hold off;

xlabel('Time (ms)');
ylabel('Solution Cost');
%title('Kino-PAX*-offline Vs. Kino-PAX*-online Solution Cost Over Time')
legend([boxplot1(5), boxplot2(5)], {'KPAX*-Small-\delta', 'KPAX*-Large-\delta'}, 'Location', 'northeast');

grid on;
set(gca, 'XTick', timeGrid);
set(gca, 'XTickLabel', arrayfun(@num2str, timeGrid, 'UniformOutput', false));

ylim([4.6 5.8]);  % Set y-limits scaled down by 1

% Set figure size and save the figure as before.
set(gcf, 'PaperUnits', 'inches');
set(gcf, 'PaperSize', [8.5 8.5]);
set(gcf, 'PaperPosition', [0 0 8.5 8.5]);
fileName = 'KPAX*_KPAX*_6DDI_house.pdf';
print(gcf, fileName, '-dpdf');
